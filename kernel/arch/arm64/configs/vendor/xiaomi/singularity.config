CONFIG_LOCALVERSION="-Singularity-v1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KSU=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KPROBES is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_OVERLAY_FS=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="performance"
# CONFIG_DEBUG_INFO is not set
# CONFIG_CC_WERROR is not set
# CONFIG_CPU_FREQ_SWITCH_PROFILER is not set
CONFIG_NOCI_RAW_PERF=y
CONFIG_MSM_PERFORMANCE=y
